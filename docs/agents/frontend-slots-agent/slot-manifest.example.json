{
  "schemaVersion": "2.0",
  "gameId": "example-slot",
  "buildIntent": "showcase | production",
  "source": {
    "family": "showcase-cascade | showcase-reelmult | jeepney-4x3-wheel | new-engine",
    "referenceProject": "TBD",
    "workFromCopy": true,
    "changeClass": [
      "GREEN"
    ]
  },
  "concept": {
    "referenceWidth": 1080,
    "referenceHeight": 1920,
    "preferredOrientation": "portrait",
    "backgroundPolicy": "cover",
    "gameplayPolicy": "contain-safe",
    "approvedConceptPath": "TBD"
  },
  "layout": {
    "reels": {
      "x": 120,
      "y": 520,
      "width": 840,
      "height": 720
    },
    "specialReelOrWheel": null,
    "winZone": {
      "anchor": "bottom-center",
      "safeMargin": 32
    },
    "controlsZone": {
      "anchor": "bottom",
      "safeAreaAware": true
    },
    "featureZones": []
  },
  "assets": {
    "preserveStableIds": true,
    "spineSemanticStates": [
      "idle",
      "land",
      "win",
      "anticipation",
      "trigger",
      "loop",
      "exit"
    ],
    "artPipelineMcpAllowed": true
  },
  "math": {
    "authority": "server | demo-local",
    "provider": "ServerResultProvider | MockResultProvider | ScenarioResultProvider | RecordedResultProvider",
    "contractVersion": "TBD",
    "mathVersion": "TBD",
    "rtpProfileId": "TBD",
    "configChecksum": "TBD",
    "currencyStorage": "integer-credits",
    "paytableSource": "active-math-config",
    "redChangesRequireSimulation": true
  },
  "presentation": {
    "grammar": [
      "cause",
      "recognition",
      "focus",
      "reward",
      "read",
      "release"
    ],
    "timingProfiles": [
      "normal",
      "turbo1",
      "turbo2",
      "reducedMotion"
    ],
    "symbolTapShowsPayout": true,
    "symbolInspectorOnlyWhenSettled": true,
    "bonusTransitionDirector": true,
    "cancellableSequences": true,
    "roundAndSequenceIds": true,
    "seededVisualRng": true
  },
  "qa": {
    "fullResultFixtures": true,
    "presentationOnlyReplay": true,
    "recordedRoundReplay": true,
    "boardResultDiff": true,
    "settlementReconciliation": true,
    "visualRegression": true,
    "productionDevTools": false
  },
  "recovery": {
    "idempotentRoundProtocol": true,
    "runtimeSchemaValidation": true,
    "requestTimeoutAbort": true,
    "visibilityResume": true,
    "refreshReconnect": true,
    "staleCallbackRejection": true
  },
  "performance": {
    "mobileFirst": true,
    "preloadFeatureAssetsBeforeTransition": true,
    "measureFrameTime": true,
    "measureTextureMemory": true,
    "measureRendererBatches": true,
    "testRepresentativePhone": true
  },
  "economics": {
    "simulator": "tools/sim.mjs (bonuses played in full)",
    "targetReturn": "TBD (showcase: roughly at or below price for every option)",
    "maxWinX": 5000,
    "maxWinScope": "round (trigger spin + whole feature)",
    "extraBet": {
      "cost": 1.25,
      "visibleBenefit": "TBD",
      "measuredReturn": "TBD"
    },
    "featureBuys": [
      {
        "id": "wts",
        "label": "feature spins (cheap tier)",
        "priceX": "TBD",
        "measuredMeanX": "TBD"
      },
      {
        "id": "standard",
        "priceX": "TBD",
        "measuredMeanX": "TBD"
      },
      {
        "id": "enhanced",
        "priceX": "TBD",
        "measuredMeanX": "TBD",
        "naturalRoute": "TBD"
      }
    ]
  }
}
